# =========================================================================
#  PixelReads Environment Configuration
# =========================================================================
#
#  For Expo, use EXPO_PUBLIC_ prefix for client-side env vars.
#  These can be set in your shell or CI/CD pipeline.
#
#  Example:
#    EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your_key npx expo start
#
# =========================================================================

# Google Books API
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# =========================================================================
#  Note: For local development, the API key is set directly in
#  src/api/config.js. For production builds, use EAS secrets:
#  https://docs.expo.dev/build-reference/variables/
# =========================================================================
